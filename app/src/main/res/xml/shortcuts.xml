<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="capture"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/sc_capture">
        <intent
            android:action="com.eko.constellation.CAPTURE"
            android:targetClass="com.eko.constellation.MainActivity"
            android:targetPackage="com.eko.constellation" />
    </shortcut>
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/sc_voice">
        <intent
            android:action="com.eko.constellation.VOICE"
            android:targetClass="com.eko.constellation.MainActivity"
            android:targetPackage="com.eko.constellation" />
    </shortcut>
</shortcuts>
